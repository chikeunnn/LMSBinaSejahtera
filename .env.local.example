# Environment Variables untuk LMS Bina Sejahtera
# Salin file ini menjadi .env.local dan isi dengan nilai yang sebenarnya

# ============================================================
# SUPABASE CONFIGURATION
# Dapatkan dari: https://app.supabase.com → Project Settings → API
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# PENTING: Service role key HANYA boleh di server, JANGAN expose ke browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# APP CONFIGURATION
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LMS Bina Sejahtera
